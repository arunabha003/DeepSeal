# Server
PORT=3001

# When true, POST /kyb is paywalled via x402.
X402_ENABLED=false

# x402 settings
# Network must be one of: base-sepolia, base, avalanche-fuji, etc (see x402 NetworkSchema).
X402_NETWORK=base-sepolia

# Recipient address for payments (your wallet address on the chosen network).
X402_PAY_TO=0x0000000000000000000000000000000000000000

# Price in USD (converted to USDC atomic amount by x402 helpers; 0.01 => 10000 atoms at 6 decimals).
KYB_PRICE=0.01

# Max time (seconds) a payment is considered valid.
X402_TIMEOUT_SECONDS=120
