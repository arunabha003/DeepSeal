# Server
PORT=3001

# When true, POST /kyb is paywalled via x402.
X402_ENABLED=false

# x402 settings
# Network must be one of: base-sepolia, base, avalanche-fuji, etc (see x402 NetworkSchema).
X402_NETWORK=base-sepolia

# Recipient address for payments (your wallet address on the chosen network).
# NOTE: this MUST be an address (0x + 40 hex chars), not a private key.
X402_PAY_TO=0x0000000000000000000000000000000000000000

# RPC used by local x402 verify/settle facilitator logic.
# For Anvil fork tests, use http://127.0.0.1:8545
X402_RPC_URL=

# Relayer key used to submit transferWithAuthorization in settle.
# If omitted, PRIVATE_KEY is used.
X402_RELAYER_PRIVATE_KEY=

# Price in USD (converted to USDC atomic amount by x402 helpers; 0.01 => 10000 atoms at 6 decimals).
KYB_PRICE=0.01

# Max time (seconds) a payment is considered valid.
X402_TIMEOUT_SECONDS=120

# --- Sumsub (Sandbox) ---
# Create Sandbox keys in Sumsub and put them here.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=

# Business verification level name from your Sumsub dashboard (sandbox).
SUMSUB_LEVEL_NAME=
