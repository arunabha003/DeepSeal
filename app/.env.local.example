# Copy to `.env.local` (gitignored) and fill values.

# ── Network mode: "local" (Anvil) or "testnet" (real Base Sepolia) ──
NEXT_PUBLIC_NETWORK=testnet

# UI privacy badge override (optional). Defaults to true on testnet, false on local.
NEXT_PUBLIC_CONFIDENTIAL_HTTP=true

# ── For "testnet" mode (real Base Sepolia deployer) ──
DEPLOYER_PRIVATE_KEY=<your-deployer-private-key>
RPC_URL=https://sepolia.base.org

# ── For "local" mode (Anvil account #0) ──
# DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80
# RPC_URL=http://127.0.0.1:8545
