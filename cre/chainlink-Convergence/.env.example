# Copy to `.env` (gitignored) and fill values.
#
# Required for local simulation if the workflow does on-chain writes:
CRE_ETH_PRIVATE_KEY=
#
# Secret used by the workflow via `runtime.getSecret({ id: "GEMINI_API_KEY" })`
GEMINI_API_KEY=

# Optional: if `x402Enabled=true` in workflow config and KYB endpoint returns 402,
# the workflow will read this secret and perform the x402 buyer retry (Exact EVM / EIP-3009).
X402_BUYER_PRIVATE_KEY=
