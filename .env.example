# Copy to `.env` (gitignored) and fill values.

# --- Gemini (required for `tools/process-request.mjs` and CRE workflow) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Local KYB stub (optional; replace later with real provider endpoint) ---
KYB_URL=http://127.0.0.1:8787/kyb

# --- Onchain addresses (fill after deploying) ---
RPC_URL=
PORTAL_ADDRESS=
RECEIVER_ADDRESS=

