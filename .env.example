# Copy to `.env` (gitignored) and fill values.

# --- Gemini (required for `tools/process-request.mjs` and CRE workflow) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Local KYB provider (optional; replace later with real provider endpoint) ---
# Free route for CRE simulation by default:
KYB_URL=http://127.0.0.1:3001/kyb/free

# --- Onchain addresses (fill after deploying) ---
RPC_URL=
PORTAL_ADDRESS=
RECEIVER_ADDRESS=
